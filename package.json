{
  "name": "dapp",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "AMM",
  "scripts": {
    "ui": "pnpm --filter ui",
    "script": "pnpm --filter dapp",
    "dapp": "pnpm --filter dapp",
    "tooling": "pnpm --filter tooling",
    "test:integration": "pnpm --filter ./packages/dapp test:integration",
    "typecheck": "tsc -b",
    "lint": "eslint \"packages/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "lint:fix": "eslint --fix \"packages/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "glob": "^13.0.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": ">=7.29.6",
      "axios": ">=1.18.1",
      "brace-expansion@>=5.0.0": ">=5.0.8",
      "esbuild@<0.28.1": ">=0.28.1",
      "flatted@<=3.4.1": "3.4.2",
      "follow-redirects@<=1.15.11": ">=1.16.0",
      "form-data@<4.0.6": ">=4.0.6",
      "js-cookie@<=3.0.5": ">=3.0.7",
      "next@>=16.0.0-beta.0 <16.2.11": ">=16.2.11",
      "picomatch@<4.0.4": ">=4.0.4",
      "postcss@<8.5.18": ">=8.5.18",
      "sharp@<0.35.0": ">=0.35.0",
      "valibot@<=1.4.1": ">=1.4.2",
      "vite@>=7.0.0 <7.3.6": ">=7.3.6",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    }
  }
}
