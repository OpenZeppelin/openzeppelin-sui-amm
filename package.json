{
  "name": "dapp",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "AMM",
  "scripts": {
    "ui": "pnpm --filter ui",
    "script": "pnpm --filter dapp",
    "dapp": "pnpm --filter dapp",
    "tooling": "pnpm --filter tooling",
    "test:integration": "pnpm --filter ./packages/dapp test:integration",
    "typecheck": "tsc -b",
    "lint": "eslint \"packages/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "lint:fix": "eslint --fix \"packages/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.15",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "glob": "^13.0.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "pnpm": {
    "overrides": {
      "axios@>=1.0.0 <1.15.0": ">=1.15.0",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "flatted@<=3.4.1": "3.4.2",
      "follow-redirects@<=1.15.11": ">=1.16.0",
      "next@>=16.0.0-beta.0 <16.2.3": ">=16.2.3",
      "picomatch@<4.0.4": ">=4.0.4",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
